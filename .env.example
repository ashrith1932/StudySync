# ==============================================================================
# StudySync - Global Environment Variables Template
# Copy this file to .env in backend/ or root for local development.
# IMPORTANT: DO NOT COMMIT SENSITIVE PASSWORDS OR PRODUCTION SECRETS TO GIT.
# ==============================================================================

# Server Environment & Port Configuration
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=studysync_db
DB_USER=studysync_user
DB_PASSWORD=studysync_dev_password
DB_POOL_MIN=2
DB_POOL_MAX=10

# Authentication & Security
JWT_SECRET=super_secret_development_jwt_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=24h
BCRYPT_SALT_ROUNDS=10

# Logging & Debugging
LOG_LEVEL=debug

# Frontend Vite Port (Reference for CORS)
VITE_API_BASE_URL=http://localhost:5000/api/v1
